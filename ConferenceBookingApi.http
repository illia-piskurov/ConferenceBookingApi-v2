@ConferenceBookingApi_HostAddress = http://localhost:5254

### =====
### ROOMS
### =====

### 1. Create Room 1 — "Main Hall"
# @name createRoom1
POST {{ConferenceBookingApi_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Main Hall",
  "capacity": 50,
  "baseHourlyRate": 200.00,
  "services": [
    { "name": "Projector", "price": 50.00 },
    { "name": "Coffee Break", "price": 30.00 }
  ]
}

###

@room1Id = {{createRoom1.response.body.$.id}}
@serviceProjectorId = {{createRoom1.response.body.$.availableServices[0].id}}
@serviceCoffeeId = {{createRoom1.response.body.$.availableServices[1].id}}

### 2. Create Room 2 — "Boardroom"
# @name createRoom2
POST {{ConferenceBookingApi_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Boardroom",
  "capacity": 12,
  "baseHourlyRate": 100.00,
  "services": [
    { "name": "Whiteboard", "price": 10.00 },
    { "name": "Video Conferencing", "price": 75.00 }
  ]
}

###

@room2Id = {{createRoom2.response.body.$.id}}

### 3. Get All Rooms
GET {{ConferenceBookingApi_HostAddress}}/api/rooms
Accept: application/json

###

### 4. Get Room 1 by ID
GET {{ConferenceBookingApi_HostAddress}}/api/rooms/{{room1Id}}
Accept: application/json

###

### 5. Update Room 1
PUT {{ConferenceBookingApi_HostAddress}}/api/rooms/{{room1Id}}
Content-Type: application/json

{
  "name": "Main Hall (Renovated)",
  "capacity": 60,
  "baseHourlyRate": 250.00,
  "services": [
    { "name": "Projector", "price": 50.00 },
    { "name": "Coffee Break", "price": 35.00 },
    { "name": "Sound System", "price": 80.00 }
  ]
}

###

### 6. Search Available Rooms (2026-08-01 09:00–12:00, capacity >= 10)
GET {{ConferenceBookingApi_HostAddress}}/api/rooms/available?start=2026-08-01T09:00:00Z&end=2026-08-01T12:00:00Z&capacity=10
Accept: application/json

###

### ============================================================
### BOOKINGS
### ============================================================

### 6.5. Refresh актуальних service ID з кімнати
# @name getRoom1Fresh
GET {{ConferenceBookingApi_HostAddress}}/api/rooms/{{room1Id}}
Accept: application/json

###

@serviceProjectorId = {{getRoom1Fresh.response.body.$.availableServices[0].id}}
@serviceCoffeeId = {{getRoom1Fresh.response.body.$.availableServices[1].id}}

### 7. Create Booking for Room 1
# @name createBooking
POST {{ConferenceBookingApi_HostAddress}}/api/bookings
Content-Type: application/json

{
  "roomId": "{{room1Id}}",
  "startTime": "2026-08-01T09:00:00Z",
  "endTime": "2026-08-01T12:00:00Z",
  "selectedServiceIds": [
    "{{serviceProjectorId}}",
    "{{serviceCoffeeId}}"
  ]
}

###

@bookingId = {{createBooking.response.body.$.id}}

### 8. Conflict Booking — той самий слот (очікується 409)
# @name conflictBooking
POST {{ConferenceBookingApi_HostAddress}}/api/bookings
Content-Type: application/json

{
  "roomId": "{{room1Id}}",
  "startTime": "2026-08-01T10:00:00Z",
  "endTime": "2026-08-01T11:00:00Z",
  "selectedServiceIds": []
}

###

### 9. Get Booking by ID
GET {{ConferenceBookingApi_HostAddress}}/api/bookings/{{bookingId}}
Accept: application/json

###

### 10. Get All Bookings for Room 1
GET {{ConferenceBookingApi_HostAddress}}/api/bookings/room/{{room1Id}}
Accept: application/json

###

### =======
### REPORTS
### =======

### 11. Revenue Report (August 2026)
GET {{ConferenceBookingApi_HostAddress}}/api/reports/revenue?from=2026-08-01T00:00:00Z&to=2026-08-31T23:59:59Z
Accept: application/json

###

### 12. Room Popularity Report
GET {{ConferenceBookingApi_HostAddress}}/api/reports/popularity
Accept: application/json

###

### 13. Room Load Report (August 2026)
GET {{ConferenceBookingApi_HostAddress}}/api/reports/load?from=2026-08-01T00:00:00Z&to=2026-08-31T23:59:59Z
Accept: application/json

###

### =======
### CLEANUP
### =======

### 14. Delete Room 1
DELETE {{ConferenceBookingApi_HostAddress}}/api/rooms/{{room1Id}}

###

### 15. Delete Room 2
DELETE {{ConferenceBookingApi_HostAddress}}/api/rooms/{{room2Id}}

###
